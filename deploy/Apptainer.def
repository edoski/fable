Bootstrap: docker
From: python:3.11-slim-trixie

%files
    pyproject.toml /opt/fable/pyproject.toml
    uv.lock /opt/fable/uv.lock
    src /opt/fable/src

%post
    python -m pip install --no-cache-dir uv==0.11.32
    cd /opt/fable
    UV_LINK_MODE=copy uv sync --frozen --no-dev --no-editable

%environment
    export PATH=/opt/fable/.venv/bin:$PATH
    export PYTHONUNBUFFERED=1

%runscript
    exec fable "$@"

%test
    python -c "import fable, lightning, polars, torch"
